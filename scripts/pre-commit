#!/bin/sh
set -e

echo "=== pre-commit: fmt ==="
bad=$(gofmt -l .)
if [ -n "$bad" ]; then
	echo "gofmt needed on:"
	echo "$bad"
	exit 1
fi

echo "=== pre-commit: vet ==="
go vet ./...

echo "=== pre-commit: test + coverage ==="
go test -gcflags=all=-l -count=1 -coverprofile=cover.out ./... 2>&1
total=$(go tool cover -func=cover.out | awk '/^total:/{print $3}' | tr -d '%')
echo "coverage: ${total}%"
rm -f cover.out
threshold=80
if [ "$(echo "$total < $threshold" | bc)" -eq 1 ]; then
	echo "FAIL: coverage ${total}% < ${threshold}%"
	exit 1
fi

echo "=== pre-commit: complexity ==="
max=12
whitelist="scripts/cc-whitelist"
# gocyclo output: "CC package func file:line"
# Filter out whitelisted functions that have their own higher max.
violations=""
while IFS= read -r line; do
	[ -z "$line" ] && continue
	cc=$(echo "$line" | awk '{print $1}')
	func=$(echo "$line" | awk '{print $2 "." $3}')
	# Check whitelist for a per-function max.
	func_max=$max
	if [ -f "$whitelist" ]; then
		wl=$(grep -F "${func} " "$whitelist" 2>/dev/null || true)
		if [ -n "$wl" ]; then
			func_max=$(echo "$wl" | awk '{print $2}')
		fi
	fi
	if [ "$cc" -gt "$func_max" ]; then
		violations="${violations}${line}
"
	fi
done <<EOF
$(gocyclo -over $((max)) .)
EOF
if [ -n "$violations" ]; then
	echo "FAIL: cyclomatic complexity exceeds threshold"
	echo "$violations"
	exit 1
fi

echo "=== pre-commit: all clear ==="
