#!/usr/bin/env bash
# pre-commit — Go quality gate: fmt, vet, test+coverage, complexity
#
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
#
# For bash idioms used in this script, see https://aka.ms/bash4thewin
#
# shellcheck enable=all
# shellcheck disable=SC2248,SC2250,SC2312

set -eu

echo "=== pre-commit: fmt ==="
bad=$(gofmt -l .)
if [[ -n $bad ]]; then
	echo "gofmt needed on:"
	echo "$bad"
	exit 1
fi

echo "=== pre-commit: vet ==="
go vet ./...

echo "=== pre-commit: errcheck ==="
errcheck -exclude errcheck-exclude -ignoretests ./...

echo "=== pre-commit: staticcheck ==="
staticcheck ./...

echo "=== pre-commit: test + coverage ==="
output=$(go test -gcflags=all=-l -count=1 -cover ./... 2>&1)
rc=$?
echo "$output"
if (( rc != 0 )); then
	exit 1
fi

# Enforce 100% statement coverage per internal/ package.
# The root package (main) is excluded — it has no tests.
fail=0
while IFS= read -r line; do
	[[ $line != ok* ]] && continue
	pkg=$(awk '{print $2}' <<< "$line")
	# skip root (main) package
	case $pkg in */internal/*) ;; *) continue ;; esac
	pct=$(grep -oP '\d+\.\d+(?=%)' <<< "$line")
	if [[ $pct != "100.0" ]]; then
		echo "FAIL: $pkg coverage ${pct}% < 100%"
		fail=1
	fi
done <<< "$output"

if (( fail )); then
	exit 1
fi

echo "=== pre-commit: complexity ==="
max=12
whitelist="cc-whitelist"
violations=()
while IFS= read -r line; do
	[[ -z $line ]] && continue
	cc=${line%% *}
	func=$(awk '{print $2 "." $3}' <<< "$line")
	func_max=$max
	if [[ -f $whitelist ]]; then
		wl=$(grep -F "$func " "$whitelist" 2>&- || :)
		if [[ -n $wl ]]; then
			func_max=${wl##* }
		fi
	fi
	if (( cc > func_max )); then
		violations+=("$line")
	fi
done <<< "$(gocyclo -over $max .)"
if (( ${#violations[@]} )); then
	echo "FAIL: cyclomatic complexity exceeds threshold"
	printf '%s\n' "${violations[@]}"
	exit 1
fi

echo "=== pre-commit: all clear ==="
