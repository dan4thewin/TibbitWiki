#!/bin/bash
# pre-commit — Go quality gate: fmt, vet, test+coverage, complexity
#
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
#
# For bash idioms used in this script, see https://aka.ms/bash4thewin
#
# shellcheck enable=all
# shellcheck disable=SC2248,SC2250,SC2312

set -eu

echo "=== pre-commit: fmt ==="
bad=$(gofmt -l .)
if [[ -n $bad ]]; then
	echo "gofmt needed on:"
	echo "$bad"
	exit 1
fi

echo "=== pre-commit: vet ==="
go vet ./...

echo "=== pre-commit: test + coverage ==="
go test -gcflags=all=-l -count=1 -coverprofile=cover.out ./... 2>&1
total=$(go tool cover -func=cover.out | awk '/^total:/{print $3}' | tr -d '%')
echo "coverage: ${total}%"
rm -f cover.out
threshold=800
# Compare as integer tenths: 86.5 → 865
total_int=${total/./}
if (( total_int < threshold )); then
	echo "FAIL: coverage ${total}% < $((threshold/10))%"
	exit 1
fi

echo "=== pre-commit: complexity ==="
max=12
whitelist="cc-whitelist"
violations=()
while IFS= read -r line; do
	[[ -z $line ]] && continue
	cc=${line%% *}
	func=$(awk '{print $2 "." $3}' <<< "$line")
	func_max=$max
	if [[ -f $whitelist ]]; then
		wl=$(grep -F "$func " "$whitelist" 2>&- || :)
		if [[ -n $wl ]]; then
			func_max=${wl##* }
		fi
	fi
	if (( cc > func_max )); then
		violations+=("$line")
	fi
done <<< "$(gocyclo -over $max .)"
if (( ${#violations[@]} )); then
	echo "FAIL: cyclomatic complexity exceeds threshold"
	printf '%s\n' "${violations[@]}"
	exit 1
fi

echo "=== pre-commit: all clear ==="
