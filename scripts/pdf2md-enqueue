#!/usr/bin/env bash
# pdf2md-enqueue — symlink a PDF into the conversion queue and
# start the queue runner if not already running.
#
# Usage: pdf2md-enqueue <pdf_path> <queue_dir> [pdf2md_flags...]
#
# The queue runner converts each queued PDF sequentially. flock
# ensures only one runner at a time. Extra flags (e.g. --model,
# --host) are passed through to pdf2md.
#
# For bash idioms used in this script, see https://aka.ms/bash4thewin
#
# shellcheck enable=all
# shellcheck disable=SC2248,SC2250

setup_bash() {
	set -eu
}

setup_vars() {
	prog=${0##*/}
	scriptdir=${0%/*}
	readonly prog scriptdir
}

pr() {
	echo "$prog: $*" >&2
}

main() {
	setup_bash
	setup_vars

	if (( $# < 2 )); then
		echo "usage: $prog <pdf_path> <queue_dir> [pdf2md_flags...]" >&2
		exit 1
	fi

	local pdf_path=$1 queue_dir=$2
	shift 2

	mkdir -p "$queue_dir"

	# Symlink the PDF into the queue.  Use a mangled name
	# (slashes → %%) to avoid basename collisions when different
	# notes have identically named attachments.
	local key=${pdf_path//\//%}
	ln -sf "$pdf_path" "$queue_dir/$key" 2>/dev/null || true

	# Try to become the queue runner (non-blocking flock).
	local pidfile=$queue_dir/.pid
	exec 9>"$pidfile"
	if ! flock -n 9; then
		# Another runner is active — our symlink will be picked up.
		exit 0
	fi

	# Double fork: background the runner so the Go parent's
	# cmd.Wait() returns immediately.  The subshell inherits
	# fd 9 and the flock — lock held until the queue is drained.
	run_queue "$@" &
}

# Process every symlink in the queue.  Runs as a backgrounded
# grandchild, reparented to init when the parent exits.
# Rescans until empty so late enqueues are not missed.
run_queue() {
	shopt -s nocaseglob nullglob
	local found=true
	while $found; do
		found=false
		local link target shadow
		for link in "$queue_dir"/*; do
			[[ -L $link ]] || continue
			found=true
			target=$(readlink "$link" 2>/dev/null) || target=$link
			shadow=${target}.md
			if [[ -f $shadow ]]; then
				rm -f "$link"
				continue
			fi
			pr "converting ${target##*/}"
			if ! "$scriptdir/pdf2md" "$target" "$@"; then
				pr "WARN: pdf2md failed for ${target##*/}"
			fi
			rm -f "$link"
		done
	done
}

(return 0) 2>&- || main "$@"
