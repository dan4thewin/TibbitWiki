#!/usr/bin/env bash
# pdf2md-enqueue — symlink a PDF into the conversion queue and
# start the queue runner if not already running.
#
# Usage: pdf2md-enqueue <pdf_path> <queue_dir> [pdf2md_flags...]
#
# The queue runner converts each queued PDF sequentially. flock
# ensures only one runner at a time. Extra flags (e.g. --model,
# --host) are passed through to pdf2md.
#
# For bash idioms used in this script, see https://aka.ms/bash4thewin
#
# shellcheck enable=all
# shellcheck disable=SC2248,SC2250

setup_bash() {
	set -eu
}

setup_vars() {
	prog=${0##*/}
	scriptdir=${0%/*}
	readonly prog scriptdir
}

pr() {
	echo "$prog: $*" >&2
}

main() {
	setup_bash
	setup_vars

	if (( $# < 2 )); then
		echo "usage: $prog <pdf_path> <queue_dir> [pdf2md_flags...]" >&2
		exit 1
	fi

	local pdf_path=$1 queue_dir=$2
	shift 2

	mkdir -p "$queue_dir"

	# Symlink the PDF into the queue (basename collision is fine —
	# same file means same conversion needed).
	ln -sf "$pdf_path" "$queue_dir/${pdf_path##*/}" 2>/dev/null || true

	# Try to become the queue runner (non-blocking flock).
	local pidfile=$queue_dir/.pid
	exec 9>"$pidfile"
	if ! flock -n 9; then
		# Another runner is active — our symlink will be picked up.
		exit 0
	fi

	# We hold the lock. Process every symlink in the queue.
	local link target shadow
	for link in "$queue_dir"/*.pdf; do
		[[ -e $link ]] || continue
		target=$(readlink "$link" 2>/dev/null) || target=$link
		shadow=${target}.md
		if [[ -f $shadow ]]; then
			rm -f "$link"
			continue
		fi
		pr "converting ${target##*/}"
		"$scriptdir/pdf2md" "$target" "$@" || true
		rm -f "$link"
	done
}

(return 0) 2>&- || main "$@"
