#!/usr/bin/env bash
# tw-start — launch tibbitwiki detached with day-of-week logging
#
# Usage: tw-start [tibbitwiki args...]
# Example: tw-start --config ~/notes/config.yaml
#
# Starts tibbitwiki in the background and returns immediately.
# No auto-restart — a crash is visible by the server's absence.
#
# For bash idioms used in this script, see https://aka.ms/bash4thewin
#
# shellcheck enable=all
# shellcheck disable=SC2248,SC2250

setup_bash() {
	set -eu
}

setup_vars() {
	prog=${0##*/}
	bin=$(command -v tibbitwiki) || {
		echo "$prog: tibbitwiki not found on PATH" >&2
		exit 1
	}
	readonly prog bin
}

# shellcheck disable=SC1091
source "${0%/*}/rotate-log"

pr() {
	echo "$prog: $*"
}

main() {
	setup_bash
	setup_vars
	local log
	setup_log log "$prog"
	pr "START ${*:+ARGV=$*}"

	pr "launching $bin $*"
	"$bin" "$@" >>"$log" 2>&1 &
	disown -h
	pr "launched pid $!"
	echo "$prog: launched pid $!" >&3
}

(return 0) 2>&- || main "$@"
